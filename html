    el.textContent = NOME_DA_IGREJA;
  });

  /* ======================= LINK PERSONALIZADO POR LÍDER =======================
     Cada líder pode ter seu próprio link, para receber diretamente as
     solicitações da sua rede, sem passar por um número central. Basta
     acrescentar ao final do endereço da página:
       ?wa=NUMERO_DO_LIDER&nome=NOME_DO_LIDER
     Exemplo:
       casa_protegida.html?wa=5561988887777&nome=Jo%C3%A3o%20Silva
     - "wa": WhatsApp do líder, só dígitos, com DDI+DDD (ex.: 5561988887777).
     - "nome": nome do líder (opcional), preenche automaticamente o campo
       "Quem te enviou este convite?" no formulário.
     Se o link não tiver esses parâmetros, o formulário usa o NUMERO_WHATSAPP
     central definido acima. Ao usar o botão "Compartilhe este convite", esses
     mesmos parâmetros seguem no link repassado, então o crédito e o destino
     do contato continuam sendo do líder que originou o convite. */
  var paramsLink = new URLSearchParams(window.location.search);
  var waLider = paramsLink.get('wa');
  var nomeLider = paramsLink.get('nome');
  var DESTINO_WHATSAPP = (waLider && /^\d{10,15}$/.test(waLider)) ? waLider : NUMERO_WHATSAPP;
  if(nomeLider){
    var campoLider = document.getElementById('lider');
    if(campoLider && !campoLider.value){ campoLider.value = nomeLider; }
  }

  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ======================= QUIZ ======================= */
  var quiz = document.getElementById('quiz-casa');
  quiz.addEventListener('submit', function(e){
    e.preventDefault();
    var total = 10, respondidas = 0, pontos = 0;
    for(var i=1;i<=total;i++){
      var campo = quiz.querySelector('input[name="q'+i+'"]:checked');
      if(campo){ respondidas++; pontos += parseInt(campo.value,10); }
    }
    if(respondidas < total){
      alert('Responda todas as afirmações para ver o resultado.');
      return;
    }
    var pct = Math.round((pontos/total)*100);
    var msg;
    if(pct <= 40){ msg = 'Sua casa está pedindo um recomeço, e isso não é fraqueza, é o primeiro passo.'; }
    else if(pct <= 70){ msg = 'Sua casa está em um momento de transição. Uma visita de oração pode fortalecer o que já existe.'; }
    else { msg = 'Sua casa está bem, e mesmo assim toda casa pode ser ainda mais protegida.'; }

    document.getElementById('quiz-pct').textContent = pct + '%';
    document.getElementById('quiz-msg').textContent = msg;
    var resultado = document.getElementById('quiz-resultado');
    resultado.classList.add('show');
    requestAnimationFrame(function(){
      document.getElementById('fio-bar-fill').style.width = pct + '%';
    });
    resultado.scrollIntoView({behavior: reduceMotion ? 'auto' : 'smooth', block:'center'});
  });

  /* ======================= FORMULÁRIO -> WHATSAPP ======================= */
  var form = document.getElementById('form-casa-protegida');
  var status = document.getElementById('form-status');
  form.addEventListener('submit', function(event){
    event.preventDefault();
    if(!form.reportValidity()) return;
    var data = new FormData(form);
    var mensagem = [
      '*SOLICITAÇÃO: CASA PROTEGIDA*','',
      '*Nome:* ' + data.get('nome'),
      '*WhatsApp:* ' + data.get('whatsapp'),
      '*Bairro/região:* ' + data.get('bairro'),
      '*Melhor período:* ' + data.get('periodo'),
      '*Quem enviou o convite:* ' + (data.get('lider') || 'Não informado'),
      '*Motivo de oração:* ' + (data.get('oracao') || 'Prefiro conversar pessoalmente'),
      '',
      '_Lembrete: após o primeiro contato, repasse esta solicitação para a coordenação central, para acompanhamento._'
    ].join('\n');
    var url = 'https://wa.me/' + DESTINO_WHATSAPP + '?text=' + encodeURIComponent(mensagem);
    var janela = window.open(url, '_blank', 'noopener,noreferrer');
    status.textContent = janela ? 'Solicitação preparada. Confirme o envio no WhatsApp que abriu agora.' : 'Seu navegador bloqueou a abertura do WhatsApp. Permita pop-ups e tente novamente.';
    status.classList.add('show');
  });

  /* ======================= COMPARTILHAR (sempre via WhatsApp) ======================= */
  var botao = document.getElementById('compartilhar-casa');
  var statusShare = document.getElementById('compartilhar-status');
  botao.addEventListener('click', function(){
    var texto = 'Pensei em você e na sua família. Conheça o Casa Protegida: uma iniciativa gratuita de cuidado, oração e esperança para você e toda família.';
    var url = window.location.href;
    try{
      window.open('https://wa.me/?text=' + encodeURIComponent(texto + '\n\n' + url), '_blank', 'noopener,noreferrer');
      statusShare.textContent = 'O convite foi preparado para compartilhamento no WhatsApp.';
      statusShare.classList.add('show');
    }catch(erro){
      statusShare.textContent = 'Não foi possível abrir o WhatsApp. Copie o endereço desta página e envie manualmente.';
      statusShare.classList.add('show');
    }
  });
})();
</script>
</body>
</html>
